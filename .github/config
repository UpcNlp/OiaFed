[core]
        repositoryformatversion = 0
        filemode = true
        bare = false
        logallrefupdates = true
        sshCommand = ssh -i ~/ct/projects/.ssh/github -o IdentitiesOnly=yes
[submodule "OiaFed"]
        url = git@github.com:UpcNlp/OiaFed.git
        active = true
[remote "origin"]
        url = git@github.com:dongshou/Unifiy-Federate.git
        fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
        remote = origin
        merge = refs/heads/main